# faydesign.ch on one.com (Apache behind Varnish, TLS ends at the proxy)

# one address: https and www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.faydesign.ch%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^faydesign\.ch$ [NC]
  RewriteRule ^ https://www.faydesign.ch%{REQUEST_URI} [L,R=301]
</IfModule>

# caching: pages always fresh, CSS/JS carry a ?v= version so they can stay long
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType video/mp4 "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 day"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
